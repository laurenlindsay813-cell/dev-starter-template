{
  "name": "dev-starter-template",
  "version": "1.0.0",
  "private": true,
  "description": "All-in-one Node.js starter template with developer tooling",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "test": "jest --coverage",
    "prepare": "husky install"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.19",
    "prettier": "^3.5.1"
  }
}
